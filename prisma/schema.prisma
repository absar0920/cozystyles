// Interwood clone — data model
// Prices are stored as integer PKR rupees (PKR does not use subunits in practice).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  passwordHash   String   @db.Text
  name           String   @db.Text
  role           String   @default("ADMIN") @db.Text // ADMIN | SUPERADMIN
  sessionVersion Int      @default(0) // bumped on password change; part of the session token
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Product {
  id             Int               @id @default(autoincrement())
  handle         String            @unique
  title          String
  bodyHtml       String            @default("") @db.MediumText
  vendor         String            @default("Cozy Furnitures") @db.Text
  productType    String            @default("") @db.Text
  status         String            @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  hot            Boolean           @default(false)
  tags           String            @default("") @db.Text // comma separated
  legacyOptions  String            @default("[]") @map("options") @db.Text // old JSON options; read only by the easy-mode migration
  rating         Float             @default(4.9)
  reviewCount    Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  variants       Variant[]
  images         ProductImage[]
  collections    Collection[]      @relation("ProductCollections")
  reviews        Review[]
  isNew          Boolean           @default(false) // "New arrival" (red NEW label)
  limitedEdition Boolean           @default(false) // "Limited edition" (yellow bar on cards)
  layout         String            @default("default") // a `ProductLayout.key`
  deliveryTime   String            @default("") @db.Text // e.g. "Delivered in 20 to 30 working days"; non-empty → FREE DELIVERY tag + PDP line
  discountGroup  Int? // 10|20|30|40|50: the mobile "Discount %" filter bucket
  cardImageRatio Float? // product card photo box height/width (live fidelity); null → 700/920
  trackStock     Boolean           @default(false) // show the optional stock count column in admin
  productOptions ProductOption[]
  inquiries      WhatsAppInquiry[]

  @@index([status, hot])
  @@index([title])
  @@index([layout])
}

model Variant {
  id              Int     @id @default(autoincrement())
  productId       Int
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title           String  @default("Default Title") @db.Text
  sku             String? @db.Text
  price           Int
  compareAtPrice  Int?
  option1         String? @db.Text
  option2         String? @db.Text
  option3         String? @db.Text
  legacyInventory Int     @default(50) @map("inventory") // read only by the easy-mode migration
  position        Int     @default(0)
  weightGrams     Int     @default(0)
  status          String  @default("READY_TO_SHIP") @db.Text // READY_TO_SHIP | MADE_TO_ORDER | PRE_ORDER | SOLD_OUT
  stock           Int? // optional stock count; null = not tracked (admin only, never drives the storefront)

  @@index([productId])
}

model ProductImage {
  id            Int                 @id @default(autoincrement())
  productId     Int
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  src           String              @db.Text
  alt           String              @default("") @db.Text
  position      Int                 @default(0)
  optionValueId Int? // "Shows: <value>"
  optionValue   ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)
  width         Int? // known for uploads
  height        Int?

  @@index([productId])
  @@index([optionValueId])
}

/// One product option (max 3 per product). position 0|1|2 ↔ Variant.option1|option2|option3.
model ProductOption {
  id        Int                  @id @default(autoincrement())
  productId Int
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String               @db.Text
  position  Int
  values    ProductOptionValue[]

  @@index([productId])
}

model ProductOptionValue {
  id          Int            @id @default(autoincrement())
  optionId    Int
  option      ProductOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value       String         @db.Text
  position    Int            @default(0)
  swatchColor String?        @db.Text // "#rrggbb" (only meaningful for Color/Colour/Finish options)
  swatchImage String?        @db.Text // photo swatch: /uploads/… or /images/…; wins over swatchColor
  images      ProductImage[]

  @@index([optionId])
}

model Collection {
  id             Int                    @id @default(autoincrement())
  handle         String                 @unique
  title          String                 @db.Text
  description    String                 @default("") @db.Text
  image          String?                @db.Text
  parentId       Int?
  parent         Collection?            @relation("CollectionTree", fields: [parentId], references: [id])
  children       Collection[]           @relation("CollectionTree")
  products       Product[]              @relation("ProductCollections")
  metafield      String                 @default("{}") @db.Text // JSON free-form (e.g. footer column)
  indexCard      CollectionIndexCard?
  layoutSections ProductLayoutSection[]

  @@index([parentId])
}

/// A card on the /collections index page ("Shop by Category"), in display order.
model CollectionIndexCard {
  id           Int         @id @default(autoincrement())
  position     Int         @default(0)
  collectionId Int?        @unique
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  /// Cards with no Collection row: the built-in "all products" cards (frontpage | all | all-1).
  systemHandle String?     @unique
  systemTitle  String?     @db.Text
  systemImage  String?     @db.Text
  /// 1..6 Shopify line-art placeholder used when the card has no photo (live fidelity).
  placeholder  Int         @default(1)
}

model MenuItem {
  id          Int        @id @default(autoincrement())
  label       String     @db.Text
  href        String     @db.Text
  location    String     @default("MAIN") // MAIN | FOOTER_1 | FOOTER_2 | ... | TOPBAR | MOBILE
  parentId    Int?
  parent      MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    MenuItem[] @relation("MenuTree")
  position    Int        @default(0)
  legacyBadge String?    @map("badge") @db.Text // old: only "STACK" had meaning (→ newColumn=false); read only by the migration
  enabled     Boolean    @default(true)
  newColumn   Boolean    @default(true) // MAIN level-2 headings: false = stack under the previous group

  @@index([location, parentId])
}

model Banner {
  id          Int     @id @default(autoincrement())
  title       String  @default("") @db.Text
  href        String? @db.Text
  image       String  @db.Text
  mobileImage String? @db.Text
  position    Int     @default(0)
  active      Boolean @default(true)
}

model Page {
  id                  Int       @id @default(autoincrement())
  handle              String    @unique
  title               String    @db.Text
  bodyHtml            String    @default("") @db.MediumText
  published           Boolean   @default(true)
  legacyIsBlogPost    Boolean   @default(false) @map("isBlogPost") // read only by the easy-mode migration
  seoTitle            String?   @db.Text
  seoDescription      String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  kind                String    @default("TEXT") // TEXT | BLOG | DESIGNED
  publishedAt         DateTime? // blog date (null → createdAt)
  author              String    @default("") @db.Text // blog author
  featuredImage       String?   @db.Text // blog featured image
  featuredImageWidth  Int?
  featuredImageHeight Int?
  tags                String    @default("") @db.Text // blog tags, comma separated labels

  @@index([kind, published])
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    String   @db.Text
  rating    Int // 1..5
  title     String   @default("") @db.Text
  body      String   @db.Text
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String   @db.Text
  email     String   @default("") @db.Text
  phone     String   @default("") @db.Text
  subject   String   @default("") @db.Text
  message   String   @db.Text
  status    String   @default("NEW") @db.Text // NEW | READ | CLOSED
  createdAt DateTime @default(now())
}

model SiteSetting {
  key   String @id
  value String @default("") @db.Text // scalar strings; JSON for structured values
}

/// Every uploaded file (one row per stored object).
model Upload {
  id           Int      @id @default(autoincrement())
  key          String   @unique // "2026/10/grey-sofa-front-a1b2c3d4.webp"
  url          String   @unique // "/uploads/2026/10/grey-sofa-front-a1b2c3d4.webp"
  originalName String   @default("") @db.Text
  mime         String   @default("image/webp") @db.Text
  width        Int
  height       Int
  bytes        Int
  purpose      String   @default("") @db.Text // product | swatch | banner | collection | blog | editor | layout
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// One row per click on a WhatsApp button (no personal data).
model WhatsAppInquiry {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  kind           String   @db.Text // ORDER | AVAILABILITY | GENERAL | TRACK
  productId      Int?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitle   String   @default("") @db.Text // snapshot at click time
  variantId      Int? // no FK: variants may be deleted later
  variantSummary String   @default("") @db.Text // "Size: 3 Seater · Color: Grey"
  quantity       Int      @default(1)
  unitPrice      Int? // PKR snapshot (null for GENERAL/TRACK, 0 = price on request)
  pagePath       String   @default("") @db.Text // "/products/alexa-sofa-chair?variant=123"

  @@index([createdAt])
  @@index([productId, createdAt])
}

/// Ledger for scripts/migrate-admin-easy-mode.ts: one row per completed step.
model MigrationStep {
  id        String   @id // e.g. "easy-mode:variant-status"
  appliedAt DateTime @default(now())
  summary   String   @default("") @db.Text
}

/// A shared "page layout": the sections shown below the description on every product that uses it.
/// `key` is what Product.layout stores. It never changes after creation (renaming changes `name` only).
model ProductLayout {
  id              Int                    @id @default(autoincrement())
  key             String                 @unique // "default", "office-products", "sofas-copy-2" … (≤ 60 chars)
  name            String                 @db.Text // owner-facing, 1–60 chars
  nameKey         String                 @unique // name.trim().toLowerCase(): DB-enforced case-insensitive uniqueness
  description     String                 @default("") @db.Text // optional "What it's for" line (purpose only, never contents)
  position        Int                    @default(0) // list + dropdown order; new layouts go last; never shown
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt // optimistic concurrency; explicitly bumped on EVERY save
  previousVersion String?                @db.MediumText // JSON snapshot of the layout before its last save ("Undo last save")
  originalVersion String?                @db.MediumText // JSON snapshot of the migrated design ("Restore the original design"); null when made from scratch
  sections        ProductLayoutSection[]
  previews        ProductLayoutPreview[]
}

/// Short-lived, admin-only preview of UNSAVED editor state. Rows expire after 2 hours and are swept on every
/// preview create. Never read without a valid admin session.
model ProductLayoutPreview {
  id        Int           @id @default(autoincrement())
  token     String        @unique // 32 random hex chars
  layoutId  Int
  layout    ProductLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  sections  String        @db.MediumText // JSON: the merged, validated section rows (same shape as a snapshot)
  expiresAt DateTime

  @@index([expiresAt])
}

/// One section of a layout, in `position` order. Shapes of `data` per kind: src/lib/product-layout-sections.ts.
model ProductLayoutSection {
  id           Int           @id @default(autoincrement())
  layoutId     Int
  layout       ProductLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  position     Int           @default(0)
  kind         String        @db.Text // overlay | imageText | icons | testimonials | slideshow | featuredCollection | recommendations | reviews
  hidden       Boolean       @default(false) // true = "Show on the store" switch off
  bodyHtml     String        @default("") @db.MediumText // sanitised rich text (overlay, imageText)
  data         String        @default("{}") @db.MediumText // JSON, shape per kind; never shown to the owner
  refs         String        @default("") @db.MediumText // derived: "\n" + lines.join("\n") + "\n" of image URLs and link pathnames; "" when none
  collectionId Int? // featuredCollection only
  collection   Collection?   @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@index([layoutId, position])
  @@index([collectionId])
}
