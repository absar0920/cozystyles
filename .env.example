# Copy to .env for local development. On Hostinger, set these in
# Websites → your Web App → Environment variables (never commit real values).

# MySQL. Local: `npm run db:up` (docker compose, port 3307). Hostinger: use 127.0.0.1, not localhost, and
# append ?connection_limit=5 (shared MySQL limits connections per user).
DATABASE_URL="mysql://root:cozystyles@127.0.0.1:3307/cozystyles"

# Long random string — `openssl rand -base64 48`. Changing it signs every admin out.
SESSION_SECRET=""

# First admin login. While the database has no admin yet, signing in with exactly these
# credentials creates the account.
ADMIN_EMAIL="admin@cozystyle.pk"
ADMIN_PASSWORD=""

# Where uploaded photos are written. In production it MUST be outside the deployed app folder
# (Hostinger replaces it on every deploy), e.g. /home/u123456789/cozystyles-prod-uploads
UPLOADS_DIR="./storage/uploads"

NEXT_PUBLIC_SITE_NAME="Cozy Furnitures"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Search engines index only the live shop, recognised by NEXT_PUBLIC_SITE_URL (staging./dev./localhost are not).
# Force it with on|off; read at build time (docs/DEPLOY-HOSTINGER.md → Search engines).
# NEXT_PUBLIC_SEARCH_INDEXING=on

# Number of reverse proxies in front of the app whose X-Forwarded-For entries are trusted (rate limits).
# TRUSTED_PROXY_HOPS=1
