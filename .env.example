# Copy to .env for local development. On Hostinger, set these in
# Websites → your Node.js app → Environment variables (never commit real values).

# MySQL. Local: `npm run db:up` (docker compose). Hostinger: use 127.0.0.1, not localhost.
DATABASE_URL="mysql://root:interwood@127.0.0.1:3307/interwood"

# Long random string — `openssl rand -base64 48`. Changing it signs every admin out.
SESSION_SECRET=""

# First admin login. While the database has no admin yet, signing in with exactly these
# credentials creates the account (or run `npm run db:admin`).
ADMIN_EMAIL="admin@interwood.pk"
ADMIN_PASSWORD=""

# Where admin-uploaded images are written. MUST be outside the deployed app folder on
# Hostinger (deploys replace it), e.g. /home/u123456789/interwood-uploads
UPLOAD_DIR="./uploads"
# Public URL prefix for uploads. Default /uploads (served by the app, cached by the CDN).
# UPLOAD_PUBLIC_URL="https://cdn.interwood.pk/uploads"

NEXT_PUBLIC_SITE_NAME="Interwood"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
